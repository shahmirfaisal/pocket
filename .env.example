# Public URL of the app (HTTPS is required for Face ID and push notifications)
APP_URL=https://pocket.shahmirfaisal.com
APP_DOMAIN=pocket.shahmirfaisal.com

MONGODB_URI=mongodb://mongo:27017/pocket
REDIS_URL=redis://redis:6379

# Zoho Mail SMTP (use smtppro.zoho.com for paid Zoho Workplace accounts,
# smtp.zoho.eu / smtp.zoho.in if your Zoho account is in that region)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=me@shahmirfaisal.com
# An app-specific password from Zoho (Settings > Security > App passwords)
SMTP_PASS=
MAIL_FROM="Pocket <me@shahmirfaisal.com>"

# Web push keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:me@shahmirfaisal.com

# Where receipt photos are stored
UPLOAD_DIR=/data/uploads
