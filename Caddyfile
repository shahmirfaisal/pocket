# Add this block to /etc/caddy/Caddyfile on the server, then: sudo systemctl reload caddy
pocket.shahmirfaisal.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Receipt photos are uploaded through the app
	request_body {
		max_size 8MB
	}

	reverse_proxy 127.0.0.1:3003
}
